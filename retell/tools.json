Paid Search","Referral","Social Media","Walk-In","Vehicle Marketplace"],"default":"Inbound Call"},"budget":{"type":["integer","null"],"minimum":3000,"maximum":100000},"vehicle_interest":{"type":["string","null"],"pattern":"^VEH-[0-9]{6}$"},"purchase_timeline":{"enum":["Within 7 Days","Within 30 Days","1-3 Months","3-6 Months","Researching",null]},"financing_needed":{"type":["boolean","null"]},"trade_in":{"type":["boolean","null"]},"test_drive_requested":{"type":"boolean","default":false},"assigned_salesperson":{"type":["string","null"],"pattern":"^SP-[0-9]{3}$"},"notes":{"type":"string","maxLength":1000}}}},{"name":"create_test_drive","method":"POST","path":"/api/tools/create-test-drive","confirmation":"explicit","body":{"type":"object","required":["lead_id","customer_id","vehicle_id","salesperson_id","appointment_date","appointment_time"],"additionalProperties":false}},{"name":"estimate_financing","method":"POST","path":"/api/tools/estimate-financing","confirmation":"none","response_rule":"Always speak disclaimer","body":{"type":"object","required":["vehicle_id","term_months","down_payment"],"properties":{"vehicle_id":{"type":"string"},"term_months":{"enum":[36,48,60,72]},"down_payment":{"type":"number","minimum":0}}}},{"name":"capture_trade_in","method":"POST","path":"/api/tools/capture-trade-in","confirmation":"explicit","response_rule":"Describe this as a preliminary estimate, never a binding appraisal","body":{"type":"object","required":["lead_id","customer_id","make","model","year","mileage","condition"],"additionalProperties":true}},{"name":"escalate_to_human","method":"POST","path":"/api/tools/escalate-to-human","confirmation":"customer_request_or_policy","body":{"type":"object","required":["session_id","reason","summary"],"additionalProperties":true}},{"name":"record_conversation_outcome","method":"POST","path":"/api/tools/record-conversation-outcome","confirmation":"none","body":{"type":"object","required":["session_id","channel","status","outcome","starte