{"version":"1.0","base_url":"{{BACKEND_BASE_URL}}","tools":[{"name":"search_inventory","description":"Search authoritative available inventory. Every non-null search field is an AND hard filter, so send only explicit requirements. Omit or send null for preferences. If no vehicles match, retry after removing preferences but never remove stated must-haves. Put AWD/All-Wheel Drive in drivetrain only, never in features. Every listed feature is required. condition searches exactly one of New, Used, or Certified Pre-Owned (CPO); do not describe one condition search as covering multiple conditions.","method":"POST","path":"/api/tools/search-inventory","confirmation":"none","body":{"type":"object","additionalProperties":false,"properties":{"make":{"type":["string","null"]},"model":{"type":["string","null"]},"trim":{"type":["string","null"],"description":"Vehicle trim level (e.g. XSE, LE). Do not combine this into the model field."},"body_type":{"type":["string","null"],"enum":["SUV","Sedan","Truck","Hatchback",null]},"condition":{"type":["string","null"],"enum":["New","Used","Certified Pre-Owned",null]},"budget_min":{"type":["integer","null"]},"budget_max":{"type":["integer","null"]},"year_min":{"type":["integer","null"]},"year_max":{"type":["integer","null"]},"mileage_max":{"type":["integer","null"]},"drivetrain":{"type":["string","null"],"enum":["FWD","RWD","AWD","4WD",null]},"fuel_type":{"type":["string","null"],"enum":["Gasoline","Diesel","Hybrid","Plug-in Hybrid","Electric",null]},"seating_capacity":{"type":["integer","null"],"description":"Minimum required seating capacity."},"features":{"type":["array","null"],"items":{"type":"string"},"description":"Explicit must-have equipment only. All listed features must exist on a vehicle; do not put drivetrain aliases here."},"limit":{"type":["integer","null"],"default":5}}}},{"name":"get_vehicle_details","method":"GET","path":"/api/tools/get-vehicle-details/{vehicle_id}","confirmation":"none","parameters":{"type":"object","re